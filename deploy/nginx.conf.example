# 穿云 · nginx 前置反代样例
#
# 穿云服务端只监听内网明文 HTTP（默认 127.0.0.1:7080），由 nginx 在 443 终止 TLS
# 并按泛域名反代过来。这样 443 端口与证书续期仍归现有 nginx 管理，穿云不碰证书。
#
# 宝塔面板用户注意：把本文件放进 /www/server/panel/vhost/nginx/ 下的独立 conf，
# 不要直接改面板生成的站点配置——面板重写配置时会覆盖你的改动。
#
# 另外两条链路不经过 nginx，需要在防火墙/安全组直接放行：
#   - 控制通道 :7000（客户端出站连接，自带 TLS）
#   - TCP 隧道端口池 :20000-20100（V1.5 功能）

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    http2 on;
    server_name *.t.example.com;

    ssl_certificate     /etc/ssl/t.example.com/fullchain.pem;
    ssl_certificate_key /etc/ssl/t.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:7080;
        proxy_http_version 1.1;

        # 子域名路由完全依赖原始 Host，必须原样透传
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # WebSocket 升级
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # 关闭缓冲，否则 SSE 不实时、大响应会被落盘
        proxy_buffering off;
        proxy_request_buffering off;

        # 调试场景下长连接常见，超时放宽
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        # 大文件上传
        client_max_body_size 200m;
    }
}

server {
    listen 80;
    server_name *.t.example.com;
    return 301 https://$host$request_uri;
}

# 自定义域名：为该域名再加一个 server 块（配它自己的证书），proxy_pass 指向同一个 7080。
# 穿云服务端按 Host 精确匹配，优先于约定式子域名。
