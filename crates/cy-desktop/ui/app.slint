import { Button, LineEdit, ScrollView, Switch, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AboutSlint } from "std-widgets.slint";

// 界面上的一条隧道。字段是从 cy-core 的状态映射过来的，界面自己不推导任何东西。
export struct TunnelUi {
    name: string,
    local-port: int,
    // "http" 或 "tcp"
    kind: string,
    // 设了访问口令
    protected: bool,
    // 公网地址；空字符串表示还没开通
    url: string,
    enabled: bool,
    // 开通失败的原因，空表示没出错
    error: string,
}

// 一条穿过隧道的请求，给观测面板用
export struct RequestUi {
    id: int,
    method: string,
    path: string,
    status: int,
    duration-ms: int,
    tunnel: string,
}

// 一条接入（用别人的服务）
export struct ConnectUi {
    local-port: int,
    from: string,
    upstream: string,
    running: bool,
    error: string,
}

component StatusDot inherits Rectangle {
    in property <bool> on;
    in property <bool> pending;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.on ? Theme.ok : (root.pending ? Theme.warn : Theme.muted);
    opacity: root.pending ? 0.6 : 1.0;
}

component Card inherits Rectangle {
    background: Theme.card;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.line;
}

// 一条隧道的卡片
component TunnelRow inherits Card {
    in property <TunnelUi> tunnel;
    callback toggle(bool);
    callback copy();
    callback remove();
    callback show-qr();
    // 改口令；传空字符串表示去掉
    callback set-auth(string);

    property <bool> editing-auth: false;

    height: self.preferred-height;

    VerticalLayout {
        padding: Theme.pad;
        spacing: 6px;

        HorizontalLayout {
            spacing: 10px;
            alignment: start;

            StatusDot {
                on: root.tunnel.url != "";
                pending: root.tunnel.enabled && root.tunnel.url == "";
                y: 6px;
            }

            Text {
                text: root.tunnel.name;
                font-size: 15px;
                font-weight: 600;
                color: Theme.ink;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            Switch {
                checked: root.tunnel.enabled;
                toggled => { root.toggle(self.checked); }
            }
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Text {
                text: "127.0.0.1:" + root.tunnel.local-port;
                font-size: 12px;
                color: Theme.muted;
                vertical-alignment: center;
            }
            if root.tunnel.kind == "tcp": Text {
                text: "TCP";
                font-size: 10px;
                color: Theme.accent-ink;
                vertical-alignment: center;
            }
            if root.tunnel.protected: Text {
                text: @tr("已设口令");
                font-size: 10px;
                color: Theme.warn;
                vertical-alignment: center;
            }
        }

        if root.tunnel.url != "": HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.tunnel.url;
                font-size: 13px;
                color: Theme.accent-ink;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Button { text: @tr("复制"); clicked => { root.copy(); } }
            Button { text: @tr("二维码"); clicked => { root.show-qr(); } }
        }

        if root.tunnel.error != "": Rectangle {
            background: Theme.danger-soft;
            border-radius: 4px;
            height: msg.preferred-height + 12px;
            msg := Text {
                text: root.tunnel.error;
                font-size: 12px;
                color: Theme.danger;
                wrap: word-wrap;
                x: 8px;
                width: parent.width - 16px;
                y: 6px;
            }
        }

        if root.editing-auth: VerticalLayout {
            spacing: 6px;
            Text {
                text: root.tunnel.protected
                    ? @tr("新口令（用户名:口令）；留空并保存 = 去掉口令")
                    : @tr("口令（用户名:口令），例如 demo:s3cret");
                font-size: 11px;
                color: Theme.muted;
                wrap: word-wrap;
            }
            auth-edit := LineEdit { placeholder-text: "demo:s3cret"; }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Button {
                    text: @tr("取消");
                    clicked => { root.editing-auth = false; auth-edit.text = ""; }
                }
                Button {
                    text: @tr("保存");
                    primary: true;
                    clicked => {
                        root.set-auth(auth-edit.text);
                        auth-edit.text = "";
                        root.editing-auth = false;
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                text: root.tunnel.protected ? @tr("改口令") : @tr("设口令");
                clicked => { root.editing-auth = !root.editing-auth; }
            }
            Button { text: @tr("删除"); clicked => { root.remove(); } }
        }
    }
}

export component AppWindow inherits Window {
    title: @tr("穿云");
    preferred-width: 640px;
    preferred-height: 560px;
    min-width: 480px;
    min-height: 420px;
    background: Theme.bg;
    icon: @image-url("icon.png");

    // ---- 由 Rust 侧填充 ----
    in property <bool> logged-in;
    in property <bool> connected;
    in property <string> status-text: @tr("未连接");
    in property <int> reconnect-attempt;
    in property <string> domain-suffix;
    in property <[TunnelUi]> tunnels;
    in property <[RequestUi]> requests;
    in property <[ConnectUi]> connects;
    in property <string> login-error;
    in property <bool> login-busy;
    in property <string> default-server;
    in property <string> version;
    // 二维码弹层：非空时显示
    in property <image> qr-image;
    in property <string> qr-url;
    // 设置项
    in-out property <bool> autostart;
    // 检查更新的结果，直接显示给用户看
    in property <string> update-text;
    in property <bool> update-checking;
    // 非空表示有新版本可下载
    in property <string> update-url;
    // 服务端连上时告诉我们的新版本；非空就在隧道页顶上挂一条横幅
    in property <string> update-banner-version;
    in property <string> update-banner-url;
    // 用户点了「知道了」就这一次不再显示（重开应用会再提示——那是故意的）
    property <bool> update-banner-dismissed: false;

    // ---- 由界面触发 ----
    callback login(string, string, string);
    callback logout();
    callback add-tunnel(string, int, string);
    callback toggle-tunnel(string, bool);
    callback remove-tunnel(string);
    callback set-tunnel-auth(string, string);
    callback copy-url(string);
    callback show-qr(string);
    callback close-qr();
    callback set-autostart(bool);
    callback check-update();
    callback open-url(string);
    callback replay(int);
    callback clear-requests();
    callback add-connect(string, int);
    callback remove-connect(int);

    // 页面：0 = 隧道列表，1 = 设置
    property <int> page: 0;
    property <bool> adding: false;

    // ================= 登录页 =================
    if !root.logged-in: VerticalLayout {
        padding: 32px;
        spacing: 14px;
        alignment: center;

        Text {
            text: @tr("穿云");
            font-size: 26px;
            font-weight: 700;
            color: Theme.ink;
            horizontal-alignment: center;
        }
        Text {
            text: @tr("输入管理员发给你的凭证即可开始");
            font-size: 13px;
            color: Theme.muted;
            horizontal-alignment: center;
        }

        Rectangle { height: 8px; }

        Text { text: @tr("服务器"); font-size: 12px; color: Theme.muted; }
        server-input := LineEdit {
            text: root.default-server;
            placeholder-text: @tr("例如 tunnel.example.com:7000");
        }

        Text { text: @tr("凭证"); font-size: 12px; color: Theme.muted; }
        token-input := LineEdit {
            placeholder-text: "cy_...";
            // 凭证是密码级的东西，别在屏幕上明晃晃地摆着
            input-type: password;
        }

        Text { text: @tr("证书指纹（内部版可留空）"); font-size: 12px; color: Theme.muted; }
        pin-input := LineEdit {
            placeholder-text: @tr("留空则首次连接时信任服务器");
        }

        if root.login-error != "": Rectangle {
            background: Theme.danger-soft;
            border-radius: 4px;
            height: err.preferred-height + 16px;
            err := Text {
                text: root.login-error;
                color: Theme.danger;
                font-size: 12px;
                wrap: word-wrap;
                x: 10px;
                y: 8px;
                width: parent.width - 20px;
            }
        }

        Button {
            text: root.login-busy ? @tr("正在连接…") : @tr("登录");
            primary: true;
            enabled: !root.login-busy;
            clicked => {
                root.login(server-input.text, token-input.text, pin-input.text);
            }
        }
    }

    // ================= 主界面 =================
    if root.logged-in: VerticalLayout {
        spacing: 0;

        // 顶部状态条
        Rectangle {
            background: Theme.card;
            height: 52px;
            HorizontalLayout {
                padding-left: Theme.pad;
                padding-right: Theme.pad;
                spacing: 10px;

                StatusDot {
                    on: root.connected;
                    pending: root.reconnect-attempt > 0;
                    y: 22px;
                }
                Text {
                    text: root.status-text;
                    font-size: 13px;
                    color: root.connected ? Theme.ink : Theme.muted;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: @tr("隧道");
                    primary: root.page == 0;
                    clicked => { root.page = 0; }
                }
                Button {
                    text: @tr("请求");
                    primary: root.page == 1;
                    clicked => { root.page = 1; }
                }
                Button {
                    text: @tr("接入");
                    primary: root.page == 2;
                    clicked => { root.page = 2; }
                }
                Button {
                    text: @tr("设置");
                    primary: root.page == 3;
                    clicked => { root.page = 3; }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }

        // 有新版本：一条横幅，不弹窗。启动就弹窗太打扰，何况这不是非装不可的事。
        if root.update-banner-version != "" && !root.update-banner-dismissed: Rectangle {
            background: Theme.accent-soft;
            height: 40px;
            HorizontalLayout {
                padding-left: Theme.pad;
                padding-right: Theme.pad;
                spacing: 10px;
                Text {
                    text: @tr("有新版本 {}，建议更新", root.update-banner-version);
                    font-size: 12px;
                    color: Theme.accent-ink;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if root.update-banner-url != "": Button {
                    text: @tr("去下载");
                    primary: true;
                    clicked => { root.open-url(root.update-banner-url); }
                }
                Button {
                    text: @tr("知道了");
                    clicked => { root.update-banner-dismissed = true; }
                }
            }
        }

        // ---- 隧道页 ----
        if root.page == 0: VerticalLayout {
            padding: Theme.pad;
            spacing: 10px;

            if root.tunnels.length == 0 && !root.adding: VerticalLayout {
                alignment: center;
                spacing: 10px;
                Text {
                    text: @tr("还没有隧道");
                    font-size: 15px;
                    color: Theme.ink;
                    horizontal-alignment: center;
                }
                Text {
                    text: @tr("新建一条，把本机端口变成一个公网地址");
                    font-size: 12px;
                    color: Theme.muted;
                    horizontal-alignment: center;
                }
            }

            if root.tunnels.length > 0: ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 10px;
                    for t in root.tunnels: TunnelRow {
                        tunnel: t;
                        toggle(on) => { root.toggle-tunnel(t.name, on); }
                        copy => { root.copy-url(t.url); }
                        show-qr => { root.show-qr(t.url); }
                        remove => { root.remove-tunnel(t.name); }
                        set-auth(a) => { root.set-tunnel-auth(t.name, a); }
                    }
                }
            }

            // 新建表单
            if root.adding: Card {
                height: self.preferred-height;
                VerticalLayout {
                    padding: Theme.pad;
                    spacing: 8px;
                    Text {
                        text: @tr("新建隧道");
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.ink;
                    }
                    Text {
                        text: @tr("名字会变成地址的一部分，只能用小写字母、数字和连字符");
                        font-size: 12px;
                        color: Theme.muted;
                        wrap: word-wrap;
                    }
                    name-input := LineEdit { placeholder-text: @tr("名字，例如 wx"); }
                    port-input := LineEdit {
                        placeholder-text: @tr("本地端口，例如 8082");
                        input-type: number;
                    }
                    Text {
                        text: @tr("访问口令（可留空）");
                        font-size: 12px;
                        color: Theme.muted;
                    }
                    auth-input := LineEdit {
                        placeholder-text: @tr("用户名:口令，例如 demo:s3cret");
                    }
                    Text {
                        text: @tr("填了之后访问这个地址会先要口令。演示给客户看、或者隧道要开一整天时值得加一道门。");
                        font-size: 11px;
                        color: Theme.muted;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        Button {
                            text: @tr("取消");
                            clicked => { root.adding = false; }
                        }
                        Button {
                            text: @tr("创建");
                            primary: true;
                            clicked => {
                                root.add-tunnel(name-input.text, port-input.text.to-float(), auth-input.text);
                                name-input.text = "";
                                port-input.text = "";
                                auth-input.text = "";
                                root.adding = false;
                            }
                        }
                    }
                }
            }

            if !root.adding: Button {
                text: @tr("新建隧道");
                primary: true;
                clicked => { root.adding = true; }
            }
        }

        // ---- 请求观测 ----
        if root.page == 1: VerticalLayout {
            padding: Theme.pad;
            spacing: 10px;

            HorizontalLayout {
                Text {
                    text: @tr("穿过隧道的请求");
                    font-size: 13px;
                    color: Theme.ink;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                if root.requests.length > 0: Button {
                    text: @tr("清空");
                    clicked => { root.clear-requests(); }
                }
            }

            if root.requests.length == 0: VerticalLayout {
                alignment: center;
                spacing: 8px;
                Text {
                    text: @tr("还没有请求经过");
                    font-size: 14px;
                    color: Theme.ink;
                    horizontal-alignment: center;
                }
                Text {
                    text: @tr("外面访问你的隧道地址之后，请求会出现在这里，可以反复重放");
                    font-size: 12px;
                    color: Theme.muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            if root.requests.length > 0: ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 6px;
                    for r in root.requests: Card {
                        height: self.preferred-height;
                        HorizontalLayout {
                            padding: 10px;
                            spacing: 8px;
                            Text {
                                text: r.method;
                                font-size: 11px;
                                font-weight: 600;
                                color: Theme.accent-ink;
                                width: 44px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: r.path;
                                font-size: 12px;
                                color: Theme.ink;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Text {
                                text: r.status > 0 ? r.status : "…";
                                font-size: 11px;
                                color: r.status >= 400 ? Theme.danger : Theme.muted;
                                vertical-alignment: center;
                            }
                            Text {
                                text: r.duration-ms + "ms";
                                font-size: 11px;
                                color: Theme.muted;
                                vertical-alignment: center;
                            }
                            Button {
                                text: @tr("重放");
                                clicked => { root.replay(r.id); }
                            }
                        }
                    }
                }
            }
        }

        // ---- 接入别人的服务 ----
        if root.page == 2: VerticalLayout {
            padding: Theme.pad;
            spacing: 10px;

            Text {
                text: @tr("把同事的服务映射到你本地的端口上，代码里照常写 127.0.0.1");
                font-size: 12px;
                color: Theme.muted;
                wrap: word-wrap;
            }

            if root.connects.length > 0: ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 8px;
                    for c in root.connects: Card {
                        height: self.preferred-height;
                        VerticalLayout {
                            padding: Theme.pad;
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 8px;
                                StatusDot { on: c.running; y: 5px; }
                                Text {
                                    text: "127.0.0.1:" + c.local-port;
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: Theme.ink;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Button {
                                    text: @tr("移除");
                                    clicked => { root.remove-connect(c.local-port); }
                                }
                            }
                            Text {
                                text: "← " + c.upstream;
                                font-size: 12px;
                                color: Theme.muted;
                                overflow: elide;
                            }
                            if c.error != "": Text {
                                text: c.error;
                                font-size: 11px;
                                color: Theme.danger;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            Card {
                height: self.preferred-height;
                VerticalLayout {
                    padding: Theme.pad;
                    spacing: 8px;
                    Text {
                        text: @tr("新建接入");
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.ink;
                    }
                    from-input := LineEdit {
                        placeholder-text: @tr("来源，例如 zhangsan-api");
                    }
                    cport-input := LineEdit {
                        placeholder-text: @tr("映射到本地哪个端口，例如 8082");
                        input-type: number;
                    }
                    Button {
                        text: @tr("接入");
                        primary: true;
                        clicked => {
                            root.add-connect(from-input.text, cport-input.text.to-float());
                            from-input.text = "";
                            cport-input.text = "";
                        }
                    }
                }
            }
        }

        // ---- 设置页 ----
        if root.page == 3: ScrollView {
            VerticalLayout {
                padding: Theme.pad;
                spacing: 14px;

                Card {
                    height: self.preferred-height;
                    VerticalLayout {
                        padding: Theme.pad;
                        spacing: 10px;
                        HorizontalLayout {
                            Text {
                                text: @tr("开机时自动启动");
                                font-size: 13px;
                                color: Theme.ink;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Switch {
                                checked <=> root.autostart;
                                toggled => { root.set-autostart(self.checked); }
                            }
                        }
                        Text {
                            text: @tr("隧道域名后缀：") + root.domain-suffix;
                            font-size: 12px;
                            color: Theme.muted;
                        }
                    }
                }

                Card {
                    height: self.preferred-height;
                    VerticalLayout {
                        padding: Theme.pad;
                        spacing: 10px;
                        Text {
                            text: @tr("关于");
                            font-size: 14px;
                            font-weight: 600;
                            color: Theme.ink;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: @tr("穿云 ") + root.version;
                                font-size: 12px;
                                color: Theme.muted;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Button {
                                text: root.update-checking ? @tr("检查中…") : @tr("检查更新");
                                enabled: !root.update-checking;
                                clicked => { root.check-update(); }
                            }
                        }
                        if root.update-text != "": Text {
                            text: root.update-text;
                            font-size: 12px;
                            color: root.update-url != "" ? Theme.accent-ink : Theme.muted;
                            wrap: word-wrap;
                        }
                        if root.update-url != "": Button {
                            text: @tr("打开下载页");
                            primary: true;
                            clicked => { root.open-url(root.update-url); }
                        }
                        // Slint 的 Royalty-Free 许可要求在「关于」里展示归属
                        AboutSlint { }
                    }
                }

                Button {
                    text: @tr("退出登录");
                    clicked => { root.logout(); }
                }
            }
        }
    }

    // ================= 二维码弹层 =================
    if root.qr-url != "": Rectangle {
        background: #00000066;
        TouchArea { clicked => { root.close-qr(); } }

        Card {
            width: 280px;
            height: 340px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: Theme.pad;
                spacing: 10px;
                alignment: center;

                Text {
                    text: @tr("用手机扫码打开");
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.ink;
                    horizontal-alignment: center;
                }
                Image {
                    source: root.qr-image;
                    width: 200px;
                    height: 200px;
                    image-rendering: pixelated;
                }
                Text {
                    text: root.qr-url;
                    font-size: 11px;
                    color: Theme.muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Button {
                    text: @tr("关闭");
                    clicked => { root.close-qr(); }
                }
            }
        }
    }
}
