// 配色与尺度。集中在这里，改一处就能全局生效。
//
// 主色取自穿云的标志（深松绿）。中性色带一点绿味，不是纯灰——
// 纯灰配彩色主色会显得两者不属于同一套设计。

export global Theme {
    out property <color> accent: #0E7A5A;
    out property <color> accent-soft: #E3F0EA;
    out property <color> accent-ink: #0A5C44;

    out property <color> bg: #F6F8F7;
    out property <color> card: #FFFFFF;
    out property <color> ink: #1B2723;
    out property <color> muted: #5C6B65;
    out property <color> line: #D9E2DD;

    out property <color> ok: #0E7A5A;
    out property <color> warn: #9A6D14;
    out property <color> danger: #A94438;
    out property <color> danger-soft: #F5E4E1;

    out property <length> pad: 16px;
    out property <length> radius: 6px;
}
